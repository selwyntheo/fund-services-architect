    </td></tr>
    ${sections}
    <tr><td style="background:${BRAND.navy};padding:22px 40px;font-family:${F};">
      <div style="font-weight:700;letter-spacing:0.14em;color:#ffffff;font-size:11px;margin-bottom:6px;">BNY &middot; ASSET SERVICING COMMERCIAL STRATEGY</div>
      <div style="font-size:11px;line-height:1.6;color:rgba(255,255,255,0.7);">Internal distribution only. Compiled from public sources for informational purposes. Not investment advice.</div>
    </td></tr>
  </table>
</td></tr></table>
</body></html>`;
}

// ---- MJML builder ---------------------------------------------------------
function mjText(s = "") { return String(s).replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
function buildMjml(model, { accent, headerStyle }) {
  const navy = BRAND.navy;
  const headerColor = headerStyle === "rule" ? navy : "#ffffff";
  const headerAttrs = headerStyle === "rule" ? `background-color="#ffffff" border-bottom="3px solid ${accent}"` : `background-color="${navy}"`;
  const sections = model.sections.map((s) => {
    const items = s.items.map((it, i) => {
      const border = i === 0 ? "" : `border-top="1px solid ${BRAND.line}" padding-top="18px"`;
      const logo = it.logo ? `\n        <mj-image src="${it.logo}" alt="${mjText(it.org)}" width="88px" align="left" padding="0 0 6px 0" />` : "";
      return `
      <mj-group ${border} padding="10px 0">
        <mj-column width="30%">${logo}
          <mj-text font-size="11px" font-weight="700" color="${accent}" padding="0">${mjText(it.date)}</mj-text>
          <mj-text font-size="14px" font-weight="700" color="${navy}" padding="3px 0 0 0" line-height="1.25">${mjText(it.org)}</mj-text>
        </mj-column>
        <mj-column width="70%">
          <mj-text font-size="13px" line-height="1.7" color="${BRAND.ink}" padding="0">${mjText(it.body)}</mj-text>
          <mj-text font-size="12px" padding="8px 0 0 0"><a href="${it.link}" style="color:${accent};font-weight:600;text-decoration:none;">Read more &rarr;</a></mj-text>
        </mj-column>
      </mj-group>`;
    }).join("");
    return `
    <mj-section padding="20px 24px 0">
      <mj-column>
        <mj-text font-size="14px" font-weight="700" letter-spacing="1px" text-transform="uppercase" color="${navy}" padding="0 0 6px 0">${mjText(s.title)}</mj-text>
        <mj-divider border-width="1px" border-color="${BRAND.line}" padding="0 0 6px 0" />
      </mj-column>
    </mj-section>
    <mj-section padding="0 24px">
      <mj-column>${items}
      </mj-column>
    </mj-section>`;
  }).join("");

  return `<mjml>
  <mj-head>
    <mj-title>${mjText(model.masthead.title)}</mj-title>
    <mj-attributes>
      <mj-all font-family="Avenir Next, Avenir, Segoe UI, Helvetica, Arial, sans-serif" />
      <mj-text color="${BRAND.ink}" />
    </mj-attributes>
    <mj-style>a { text-decoration:none; }</mj-style>
  </mj-head>
  <mj-body background-color="${BRAND.wash}">

    <mj-section ${headerAttrs} padding="34px 24px 30px">
      <mj-column>
        <mj-text font-size="11px" letter-spacing="1.5px" text-transform="uppercase" color="${headerColor}" padding="0 0 14px 0">BNY&nbsp;&nbsp;|&nbsp;&nbsp;${mjText(model.masthead.kicker)}</mj-text>
        <mj-text font-size="40px" font-weight="700" line-height="1.05" color="${headerColor}" padding="0">${mjText(model.masthead.title)}</mj-text>
        <mj-text font-size="12px" font-weight="600" color="${headerColor}" padding="14px 0 0 0">${mjText(model.masthead.dateRange)}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="${BRAND.wash}" padding="22px 24px" border-left="4px solid ${accent}">
      <mj-column>
        <mj-text font-size="10px" letter-spacing="1.4px" text-transform="uppercase" font-weight="700" color="${accent}" padding="0 0 8px 0">This week at a glance</mj-text>
        <mj-text font-size="13.5px" line-height="1.65" color="${BRAND.ink}" padding="0">${mjText(model.masthead.summary)}</mj-text>
      </mj-column>
    </mj-section>
${sections}

    <mj-section background-color="${navy}" padding="22px 24px">
      <mj-column>
        <mj-text font-size="11px" font-weight="700" letter-spacing="1.4px" color="#ffffff" padding="0 0 6px 0">BNY &middot; ASSET SERVICING COMMERCIAL STRATEGY</mj-text>
        <mj-text font-size="11px" line-height="1.6" color="rgba(255,255,255,0.7)" padding="0">Internal distribution only. Compiled from public sources for informational purposes. Not investment advice.</mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>`;
}
